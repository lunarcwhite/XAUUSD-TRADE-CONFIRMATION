TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pilih broker single-user: mt5 | oanda | ctrader | paper
# paper = simulasi tanpa kredensial (tes win rate, uang virtual PAPER_BALANCE)
BROKER_MODE=paper
PAPER_BALANCE=10000

# --- Opsi 1: MT5 terminal (Windows) ---
# Kosongkan semua jika pakai terminal yang sudah login.
# Isi lengkap jika mau login via kode.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Opsi 2: OANDA v20 API key (practice/demo atau live, tanpa terminal) ---
# Daftar practice di OANDA -> dapat token + Account ID.
# OANDA_ENV=practice (demo/testing) atau live (real).
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
OANDA_INSTRUMENT=XAU_USD
OANDA_UNITS_PER_LOT=100

# --- Opsi 3: cTrader Open API (demo/live, tanpa terminal, cross-OS) ---
# BETA, belum verifikasi live. Buat app di cTrader ID -> Client ID/Secret (server).
# Tiap user cukup access token + account ID (via /start opsi 4).
# CTRADER_ENV=demo (uji) atau live (real).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo
CTRADER_SYMBOL=XAUUSD

# --- Registrasi mandiri (user /start lalu daftar pakai akun sendiri) ---
# true = siapa pun boleh daftar; false = hanya users.json/USERS_JSON (via admin).
OPEN_REGISTRATION=true
# Chat ID admin tambahan (pisahkan koma). Admin utama = TELEGRAM_CHAT_ID.
#ADMIN_CHAT_IDS=
# File SQLite user dinamis (otomatis dibuat, jangan di-commit).
#USERS_DB=bot_users.db

# --- Multi-user statis via admin (opsional) ---
# Cara 1: file users.json (lihat users.json.example).
# Cara 2: USERS_JSON='[{"id":"budi","telegram_chat_id":"123","broker_mode":"oanda",...}]'
# Jika dikosongkan → single-user dari .env di atas.
# Catatan MT5: tiap user MT5 butuh terminal/path berbeda (satu terminal = satu login).
#USERS_JSON=
